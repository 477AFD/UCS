<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      SERVICE-BASED DATABASE
      The database is one file: UniformComplianceDB.mdf (SQL Server LocalDB attaches it by file name).
      |DataDirectory| is the App_Data folder of this project (see Database/DataPath.cs).
      The program creates the file, the tables, the views and the sample data on the first start.

      To see it in Visual Studio:  View > Server Explorer > Connect to Database >
      "Microsoft SQL Server Database File" > choose App_Data\UniformComplianceDB.mdf

      Other servers (not a file), for example a school server:
        Data Source=SERVER-NAME;Initial Catalog=UniformComplianceDB;User ID=uniform_app;Password=YOUR-PASSWORD;Connect Timeout=30
      (the database must then be created on that server with Database/SqlScripts/01_CreateDatabase_Tables.sql)
    -->
    <add name="UniformDb"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\UniformComplianceDB.mdf;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Optional: keep the .mdf in another folder. Leave it commented to use App_Data. -->
    <!-- <add key="DataFolder" value="C:\UniformData" /> -->
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
